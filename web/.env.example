# App Environment Configuration
NODE_ENV=development
PORT=3000

# Security Credentials
ENCRYPTION_KEY=meridian-default-vault-passphrase-2026 # Must be a 32-character or longer secure string

# API Provider Keys
CIRCLE_API_KEY=your-circle-sandbox-or-live-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Blockchain Network RPC endpoints
# Default is Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.network
ARC_TESTNET_CHAIN_ID=5042002

# Smart Contract Addresses
AUTO_ESCROW_ADDRESS=0x1087E71CD83101adF154d8215522EadA51Bf891E
USDC_ADDRESS=0x538d32d3F3eDba7B6fB574972Ea0eF545f0E494a
